# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Runtime Environment Variables
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="kage_anime_universe"
SQL_USER="kage_user"
SQL_PASSWORD="kage_secure_password_here"
SQL_ADMIN_USER="kage_admin"
SQL_ADMIN_PASSWORD="kage_admin_secure_password_here"

# WebRTC Voice & Video Rooms NAT Traversal
VITE_STUN_URL="stun:stun.l.google.com:19302"
VITE_TURN_URL="turn:turn.kage.internal:3478"
VITE_TURN_USERNAME="kage_turn_user"
VITE_TURN_CREDENTIAL="kage_turn_credential"

# KAGE Opening Intro Cinematic Video Stream (.mp4 or .webm)
# Uses bundled /public/assets/kage-intro.mp4 by default
AUTHORIZED_SPLASH_VIDEO_URL="/assets/kage-intro.mp4"
VITE_SPLASH_VIDEO_URL="/assets/kage-intro.mp4"
